<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <!-- Set output MSI filename -->
    <OutputName>BorderlessMinecraft</OutputName>
    <!-- Read version from AssemblyInfo.cs for local builds -->
    <AssemblyInfoPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\BorderlessMinecraft\Properties\AssemblyInfo.cs'))</AssemblyInfoPath>
    <AssemblyInfoContent Condition="Exists('$(AssemblyInfoPath)')">$([System.IO.File]::ReadAllText('$(AssemblyInfoPath)'))</AssemblyInfoContent>
    <ExtractedVersion Condition="'$(AssemblyInfoContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(AssemblyInfoContent)', 'AssemblyVersion\("([0-9]+\.[0-9]+\.[0-9]+)').Groups[1].Value)</ExtractedVersion>
    <!-- Use extracted version if Version is not already defined (e.g., via command line) -->
    <Version Condition="'$(Version)' == '' And '$(ExtractedVersion)' != ''">$(ExtractedVersion)</Version>
    <!-- Fallback version if extraction fails -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!-- Define the version constant for WiX -->
    <DefineConstants>Version=$(Version);$(DefineConstants)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="INSTALLER_IMPLEMENTATION.md" />
    <None Include="License.rtf" />
  </ItemGroup>
</Project>